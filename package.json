{
  "name": "reptracker",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "dev": "concurrently \"vite\" \"wrangler dev --port 8787\"",
    "build": "vite build",
    "build:worker": "esbuild src/worker/index.ts --bundle --outfile=dist/worker.js --format=esm --target=es2022 --minify",
    "deploy": "npm run build && npm run build:worker && wrangler deploy",
    "db:migrate:local": "wrangler d1 execute reptracker-db --local --file=migrations/schema.sql",
    "db:migrate:remote": "wrangler d1 execute reptracker-db --remote --file=migrations/schema.sql",
    "db:seed:dump": "node scripts/dump-names.mjs",
    "db:seed:generate": "node scripts/generate-catalog-seed.mjs > migrations/seed_catalog.sql",
    "db:seed:local": "wrangler d1 execute reptracker-db --local --file=migrations/seed_catalog.sql",
    "db:seed:remote": "wrangler d1 execute reptracker-db --remote --file=migrations/seed_catalog.sql",
    "sync-waf": "node scripts/sync-waf.mjs",
    "sync-waf:dry": "node scripts/sync-waf.mjs --dry-run"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-vue": "^0.11.11",
    "drizzle-orm": "^0.45.2",
    "echarts": "^6.0.0",
    "hono": "^4.6.0",
    "jose": "^5.9.0",
    "pinia": "^2.2.0",
    "vue": "^3.5.0",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^10.0.3",
    "drizzle-kit": "^1.0.0-rc.3",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.0",
    "eslint-plugin-vue": "^10.8.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.58.1",
    "vite": "^6.4.1",
    "wrangler": "^4.80.0"
  }
}
